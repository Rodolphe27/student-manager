        <mxCell id="m3" value="Vercel&#10;&#10;static hosting + CDN&#10;React 19 SPA (Vite build)&#10;react-router-dom, Tailwind CSS&#10;served as static files + SPA rewrite" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=13;fillColor=#e9f0fe;strokeColor=#2f6fed;fontColor=#10233d;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="140" y="220" width="300" height="114" as="geometry"/></mxCell>
        <mxCell id="m4" value="Render&#10;&#10;container (free plan, Frankfurt)&#10;Spring Boot REST API&#10;Dockerized (eclipse-temurin:21-jre)&#10;Spring Security + session cookie" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=13;fillColor=#e3f5e8;strokeColor=#1c7a3c;fontColor=#10233d;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="220" width="300" height="114" as="geometry"/></mxCell>
        <mxCell id="m5" value="Supabase&#10;&#10;managed platform, independent of Render&#10;Supabase Postgres (PostgreSQL 17 engine)&#10;Hibernate ddl-auto=update&#10;free tier: cold-starts after inactivity" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=13;fillColor=#efe9fb;strokeColor=#6b46c1;fontColor=#10233d;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="620" y="460" width="300" height="114" as="geometry"/></mxCell>
