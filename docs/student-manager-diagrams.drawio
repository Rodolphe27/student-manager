        <mxCell id="f_e16b" style="endArrow=open;html=1;rounded=0;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="f_mycourses" target="f_stusvc">
