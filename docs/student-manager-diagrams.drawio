  <diagram name="Database - ER Diagram" id="db">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="d_title" value="Student Manager — Database (PostgreSQL 16)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="d_note" value="Schema is generated by Hibernate (spring.jpa.hibernate.ddl-auto = update — no migration tool yet). Physical column names via snake_case naming strategy. Every table has id (BIGINT, IDENTITY, PK) and created_at / updated_at (TIMESTAMP, NOT NULL) inherited from BaseEntity via JPA auditing. Enums are persisted as VARCHAR (@Enumerated(STRING))." style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1300" height="50" as="geometry"/>
        </mxCell>

        <!-- users -->
        <mxCell id="d_users" value="&lt;b&gt;users&lt;/b&gt;&lt;hr&gt;&lt;b&gt;id&lt;/b&gt;  BIGINT  PK, IDENTITY&lt;br&gt;username  VARCHAR  NOT NULL, UNIQUE&lt;br&gt;email  VARCHAR  NOT NULL, UNIQUE&lt;br&gt;password_hash  VARCHAR  NOT NULL  (BCrypt)&lt;br&gt;role  VARCHAR  NOT NULL   { STUDENT, TEACHER, ADMIN }&lt;br&gt;active  BOOLEAN  NOT NULL&lt;br&gt;created_at  TIMESTAMP  NOT NULL&lt;br&gt;updated_at  TIMESTAMP  NOT NULL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="360" height="180" as="geometry"/>
        </mxCell>

        <!-- students -->
        <mxCell id="d_students" value="&lt;b&gt;students&lt;/b&gt;&lt;hr&gt;&lt;b&gt;id&lt;/b&gt;  BIGINT  PK, IDENTITY&lt;br&gt;first_name  VARCHAR  NOT NULL&lt;br&gt;last_name  VARCHAR  NOT NULL&lt;br&gt;matriculation_number  VARCHAR  NOT NULL, UNIQUE&lt;br&gt;birth_date  DATE&lt;br&gt;email  VARCHAR  NOT NULL, UNIQUE&lt;br&gt;created_at  TIMESTAMP  NOT NULL&lt;br&gt;updated_at  TIMESTAMP  NOT NULL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="440" width="360" height="180" as="geometry"/>
        </mxCell>

        <!-- courses -->
        <mxCell id="d_courses" value="&lt;b&gt;courses&lt;/b&gt;&lt;hr&gt;&lt;b&gt;id&lt;/b&gt;  BIGINT  PK, IDENTITY&lt;br&gt;code  VARCHAR  NOT NULL, UNIQUE&lt;br&gt;title  VARCHAR  NOT NULL&lt;br&gt;description  VARCHAR&lt;br&gt;credit_hours  INTEGER  NOT NULL&lt;br&gt;status  VARCHAR  NOT NULL   { ACTIVE, INACTIVE, ARCHIVED }&lt;br&gt;created_at  TIMESTAMP  NOT NULL&lt;br&gt;updated_at  TIMESTAMP  NOT NULL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="900" y="440" width="380" height="180" as="geometry"/>
        </mxCell>

        <!-- enrollments -->
        <mxCell id="d_enroll" value="&lt;b&gt;enrollments&lt;/b&gt;&lt;hr&gt;&lt;b&gt;id&lt;/b&gt;  BIGINT  PK, IDENTITY&lt;br&gt;student_id  BIGINT  NOT NULL   FK → students(id)&lt;br&gt;course_id  BIGINT  NOT NULL   FK → courses(id)&lt;br&gt;enrolled_at  DATE  NOT NULL&lt;br&gt;status  VARCHAR  NOT NULL   { PENDING, CONFIRMED, CANCELLED }&lt;br&gt;grade  VARCHAR  NOT NULL   { A, B, C, D, F, NOT_GRADED }&lt;br&gt;created_at  TIMESTAMP  NOT NULL&lt;br&gt;updated_at  TIMESTAMP  NOT NULL&lt;hr&gt;&lt;i&gt;UNIQUE (student_id, course_id)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="500" y="720" width="440" height="210" as="geometry"/>
        </mxCell>

        <!-- relationships -->
        <mxCell id="d_r1" value="student_id → students.id&#10;N .. 1" style="endArrow=ERone;startArrow=ERmany;html=1;rounded=0;fontSize=10;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_enroll" target="d_students">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="640"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="d_r2" value="course_id → courses.id&#10;N .. 1" style="endArrow=ERone;startArrow=ERmany;html=1;rounded=0;fontSize=10;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_enroll" target="d_courses">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="670"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="d_r3" value="linked by email (application-level, no DB FK)  ·  1 .. 0..1" style="endArrow=ERzeroToOne;startArrow=ERone;html=1;rounded=0;dashed=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_users" target="d_students">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="d_gap" value="Note: registration inserts a row in &lt;b&gt;users&lt;/b&gt; only. A matching &lt;b&gt;students&lt;/b&gt; row must be created separately (by an ADMIN) before GET /api/students/me and the ownership check resolve for that account." style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="900" y="130" width="400" height="90" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
