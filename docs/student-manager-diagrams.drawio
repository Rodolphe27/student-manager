<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram name="System Architecture" id="arch">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="a_title" value="Student Manager — System Architecture" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- CLIENT GROUP -->
        <mxCell id="a_gClient" value="Client (browser)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="320" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="a_user" value="End user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="70" y="115" width="120" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="a_spa" value="React SPA&#10;React 19 · Vite · TypeScript · Tailwind v4&#10;React Router · AuthProvider / useAuth&#10;axios instance (services layer)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="175" width="260" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="a_ls" value="localStorage&#10;token (JWT) · user" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="110" y="315" width="180" height="70" as="geometry"/>
        </mxCell>

        <!-- VERCEL -->
        <mxCell id="a_gVercel" value="Vercel — frontend hosting" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="320" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="a_vercel" value="Static build + nginx&#10;Serves SPA bundle&#10;VITE_API_URL → Railway API&#10;TLS terminates here" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="485" width="260" height="95" as="geometry"/>
        </mxCell>

        <!-- CI -->
        <mxCell id="a_gCI" value="GitHub" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="320" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="a_repo" value="Repository (branch: main)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="70" y="675" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="a_actions" value="GitHub Actions — .github/workflows/ci.yml&#10;• frontend: npm ci · ESLint · tsc --noEmit · Vitest · build&#10;• frontend-e2e: Playwright vs production build&#10;• backend: ./mvnw clean verify (Java 21) + postgres:16 service&#10;All three are required checks for merge to main" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="730" width="260" height="185" as="geometry"/>
        </mxCell>

        <!-- RAILWAY BACKEND -->
        <mxCell id="a_gRailway" value="Railway — backend container (Docker)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="470" y="80" width="560" height="770" as="geometry"/>
        </mxCell>
        <mxCell id="a_boot" value="Spring Boot 3 · Java 21 — port 5030, context path /api&#10;forward-headers-strategy: framework (trusts X-Forwarded-*) · HSTS" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="115" width="500" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a_cors" value="CORS filter — allowed origins: http://localhost:5173, http://localhost, https://*.vercel.app" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="500" y="190" width="500" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="a_jwtfilter" value="JwtFilter (OncePerRequestFilter) — validates Bearer token, sets SecurityContext with ROLE_*" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="500" y="250" width="500" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="a_chain" value="SecurityFilterChain — stateless; URL rules map HTTP method + path → role (STUDENT / TEACHER / ADMIN)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="500" y="310" width="500" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="a_ctrl" value="REST Controllers — /api/auth · /api/students · /api/courses · /api/enrollments&#10;@PreAuthorize + OwnershipGuard on GET /api/enrollments/student/{id}" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="370" width="500" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a_svc" value="Service layer (interface + impl) — business rules&#10;Enrollment state machine: PENDING → CONFIRMED → grade; CANCELLED terminal&#10;Register always role STUDENT (anti privilege-escalation); uniform 401 on login" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="445" width="500" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a_repos" value="Spring Data JPA Repositories — UserRepository · StudentRepository · CourseRepository · EnrollmentRepository" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="500" y="540" width="500" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="a_jpa" value="Hibernate / JPA — ddl-auto=update (no migration tool) · snake_case naming" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="500" y="600" width="500" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="a_gex" value="GlobalExceptionHandler (@RestControllerAdvice) — maps exceptions → ErrorResponse(status, message, details, timestamp)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="500" y="660" width="500" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="a_act" value="Actuator — /actuator/health (permitAll) · Railway healthcheckPath&#10;Swagger UI — /swagger-ui.html · /v3/api-docs" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="720" width="500" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="a_sec" value="Cross-cutting: JWT Bearer (jjwt, HMAC-SHA, JWT_SECRET, 24 h) · BCrypt password hashing · no refresh token / server-side revocation" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="785" width="500" height="55" as="geometry"/>
        </mxCell>

        <!-- SUPABASE -->
        <mxCell id="a_gSupa" value="Supabase — managed database" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1120" y="80" width="330" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="a_pg" value="PostgreSQL 16&#10;(local: Docker Compose)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1160" y="120" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="a_tables" value="Tables&#10;• users&#10;• students&#10;• courses&#10;• enrollments  (unique student_id + course_id)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1160" y="230" width="250" height="150" as="geometry"/>
        </mxCell>

        <!-- EDGES -->
        <mxCell id="a_e1" value="uses (HTTPS)" style="endArrow=block;html=1;rounded=0;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_user" target="a_spa">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_e2" value="reads / writes" style="endArrow=open;html=1;rounded=0;fontSize=10;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_spa" target="a_ls">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_e3" value="GET / — SPA bundle (HTTPS)" style="endArrow=block;html=1;rounded=0;fontSize=10;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_ls" target="a_vercel">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_e4" value="REST /api/**  ·  Authorization: Bearer &lt;JWT&gt;  ·  JSON / HTTPS" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_spa" target="a_ctrl">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="235"/><mxPoint x="430" y="400"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="a_e5" value="JDBC / SSL · SPRING_DATASOURCE_URL" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_repos" target="a_pg">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1075" y="562"/><mxPoint x="1075" y="183"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="a_e6" value="deploy on push" style="endArrow=block;html=1;rounded=0;fontSize=10;dashed=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_actions" target="a_vercel">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="767"/><mxPoint x="360" y="532"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="a_e7" value="deploy on push" style="endArrow=block;html=1;rounded=0;fontSize=10;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_actions" target="a_boot">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="822"/><mxPoint x="440" y="157"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="a_e8" value="health probe" style="endArrow=block;html=1;rounded=0;fontSize=10;dashed=1;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_gRailway" target="a_act">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a_flowNote" value="Request path: JwtFilter → SecurityFilterChain (URL role rule) → Controller → @PreAuthorize (OwnershipGuard, where present) → Service → Repository → PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="470" y="870" width="960" height="20" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="Backend - Class Diagram" id="backend">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1820" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="b_title" value="Student Manager — Backend Class Diagram (Spring Boot 3, package-by-feature)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="b_legend" value="Legend:  ▷ hollow triangle = extends / implements   ·   ─▶ solid = uses / association   ·   ┄▶ dashed = dependency (@PreAuthorize, soft link)" style="text;html=1;fontSize=11;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1600" height="20" as="geometry"/>
        </mxCell>

        <!-- ================= COLUMN HEADERS (x: auth 40 · student 520 · course 1000 · enrollment 1480 · shared 1960 ; w=380) ================= -->
        <mxCell id="b_authHdr" value="package  feature.auth" style="text;html=1;fontStyle=1;fontSize=14;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="380" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="b_stuHdr" value="package  feature.student" style="text;html=1;fontStyle=1;fontSize=14;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="520" y="90" width="380" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="b_couHdr" value="package  feature.course" style="text;html=1;fontStyle=1;fontSize=14;align=left;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1000" y="90" width="380" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="b_enrHdr" value="package  feature.enrollment" style="text;html=1;fontStyle=1;fontSize=14;align=left;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1480" y="90" width="380" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="b_shdHdr" value="package  shared" style="text;html=1;fontStyle=1;fontSize=14;align=left;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1960" y="90" width="380" height="26" as="geometry"/>
        </mxCell>

        <!-- ===== ROW: Controller  (y=130) ===== -->
        <mxCell id="b_authCtrl" value="&lt;b&gt;AuthController&lt;/b&gt;&lt;br&gt;&lt;i&gt;@RestController /api/auth&lt;/i&gt;&lt;hr&gt;+ register(req: RegisterRequest): AuthResponse [201]&lt;br&gt;+ login(req: LoginRequest): AuthResponse" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="380" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="b_stuCtrl" value="&lt;b&gt;StudentController&lt;/b&gt;&lt;br&gt;&lt;i&gt;@RestController /api/students&lt;/i&gt;&lt;hr&gt;+ getAll(): StudentDTO[]&lt;br&gt;+ getMe(auth): StudentDTO&lt;br&gt;+ getById(id): StudentDTO&lt;br&gt;+ create(req: CreateStudentRequest): StudentDTO [201]&lt;br&gt;+ update(id, req): StudentDTO&lt;br&gt;+ delete(id): void" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="520" y="130" width="380" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="b_couCtrl" value="&lt;b&gt;CourseController&lt;/b&gt;&lt;br&gt;&lt;i&gt;@RestController /api/courses&lt;/i&gt;&lt;hr&gt;+ getAll(): CourseDTO[]&lt;br&gt;+ getById(id): CourseDTO&lt;br&gt;+ getByStatus(status): CourseDTO[]&lt;br&gt;+ create(req: CreateCourseRequest): CourseDTO [201]&lt;br&gt;+ update(id, req): CourseDTO&lt;br&gt;+ delete(id): void" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1000" y="130" width="380" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="b_enrCtrl" value="&lt;b&gt;EnrollmentController&lt;/b&gt;&lt;br&gt;&lt;i&gt;@RestController /api/enrollments&lt;/i&gt;&lt;hr&gt;+ getAll() · getById(id)&lt;br&gt;+ getByStudent(studentId)&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;@PreAuthorize(@ownershipGuard.canAccessStudentData)&lt;/i&gt;&lt;br&gt;+ getByCourse(courseId)&lt;br&gt;+ create(req: CreateEnrollmentRequest): EnrollmentDTO [201]&lt;br&gt;+ confirm(id) · cancel(id) · updateGrade(id, req)&lt;br&gt;+ delete(id): void" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1480" y="130" width="380" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="b_app" value="&lt;b&gt;StudentManagerApplication&lt;/b&gt;&lt;hr&gt;+ main(args: String[]): void" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1960" y="130" width="380" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="b_seccfg" value="&lt;b&gt;SecurityConfig&lt;/b&gt;&lt;br&gt;&lt;i&gt;@Configuration @EnableWebSecurity&lt;/i&gt;&lt;hr&gt;- jwtFilter: JwtFilter&lt;hr&gt;+ securityFilterChain(http): SecurityFilterChain&lt;br&gt;+ passwordEncoder(): PasswordEncoder&lt;br&gt;+ corsConfigurationSource(): CorsConfigurationSource" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1960" y="220" width="380" height="140" as="geometry"/>
        </mxCell>

        <!-- ===== ROW: Service «interface»  (y=400) ===== -->
        <mxCell id="b_authSvc" value="&lt;b&gt;&amp;laquo;interface&amp;raquo; AuthService&lt;/b&gt;&lt;hr&gt;+ register(req: RegisterRequest): AuthResponse&lt;br&gt;+ login(req: LoginRequest): AuthResponse" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="380" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="b_stuSvc" value="&lt;b&gt;&amp;laquo;interface&amp;raquo; StudentService&lt;/b&gt;&lt;hr&gt;+ findById(id): StudentDTO&lt;br&gt;+ findByAccountUsername(username): StudentDTO&lt;br&gt;+ accountOwnsStudent(username, studentId): boolean&lt;br&gt;+ findAll(): StudentDTO[]&lt;br&gt;+ create / update / delete" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="400" width="380" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="b_couSvc" value="&lt;b&gt;&amp;laquo;interface&amp;raquo; CourseService&lt;/b&gt;&lt;hr&gt;+ findById(id): CourseDTO&lt;br&gt;+ findAll(): CourseDTO[]&lt;br&gt;+ findByStatus(status: CourseStatus): CourseDTO[]&lt;br&gt;+ create / update / delete" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1000" y="400" width="380" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="b_enrSvc" value="&lt;b&gt;&amp;laquo;interface&amp;raquo; EnrollmentService&lt;/b&gt;&lt;hr&gt;+ findById / findAll&lt;br&gt;+ findByStudentId(id) · findByCourseId(id)&lt;br&gt;+ create(req): EnrollmentDTO&lt;br&gt;+ confirm(id) · cancel(id) · updateGrade(id, req)&lt;br&gt;+ delete(id): void" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1480" y="400" width="380" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="b_swagger" value="&lt;b&gt;SwaggerConfig&lt;/b&gt;&lt;br&gt;&lt;i&gt;@Configuration&lt;/i&gt;&lt;hr&gt;+ openAPI(): OpenAPI" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
